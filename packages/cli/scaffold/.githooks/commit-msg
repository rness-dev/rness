#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if [ ! -x ./node_modules/.bin/rness ]; then
  echo "rness: policies not checked: the rness CLI is not installed in .rness" >&2
  exit 0
fi
status=0
./node_modules/.bin/rness policy check commit-msg "$@" || status=$?
if [ "$status" -eq 20 ]; then
  exit 1
fi
if [ "$status" -ne 0 ]; then
  echo "rness: policies not checked: the rness CLI exited $status" >&2
fi
exit 0
