#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
./node_modules/.bin/rness validate
# The CLI's words are held: shown on a refusal (20) or a pass, replaced by
# one line for any other status (a crash's stack, an older CLI's help).
status=0
out=$(./node_modules/.bin/rness policy check pre-commit "$@" 2>&1) || status=$?
if [ "$status" -ne 0 ] && [ "$status" -ne 20 ]; then
  out="rness: policies not checked: the rness CLI exited $status"
fi
if [ -n "$out" ]; then
  printf '%s\n' "$out" >&2
fi
if [ "$status" -eq 20 ]; then
  exit 1
fi
exit 0
