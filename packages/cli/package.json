{
  "name": "@rness/cli",
  "version": "0.3.0",
  "description": "Configuration-plane CLI for rness workspaces: resolve, validate and sync org-level context for AI coding agents",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rness-dev/rness.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/rness-dev/rness",
  "bin": { "rness": "dist/bin/rness.js" },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "scaffold", "README.md"],
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "1.8.0",
    "commander": "15.0.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "tsup": "8.5.1",
    "typescript": "7.0.2"
  }
}
